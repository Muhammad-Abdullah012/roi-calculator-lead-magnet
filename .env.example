# Resend (email reports). Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "ChurnLens <reports@yourdomain.com>"
RESEND_FROM=
# Where lead notifications are sent
OWNER_EMAIL=

# Google Apps Script Web App URL (see scripts/apps-script/Code.gs)
GOOGLE_SHEETS_WEBHOOK_URL=

# Public site URL, used for share links / absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
